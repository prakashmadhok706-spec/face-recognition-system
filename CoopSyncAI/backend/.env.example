# ── CoopSync AI — Backend Environment Variables (EXAMPLE) ──
# Copy this file to .env and fill in your real API keys.
# The .env file is gitignored — never commit it with real keys.

# ── AI Provider (gemini | groq | openrouter) ──
AI_PROVIDER=gemini

# ── Google Gemini (https://aistudio.google.com/app/apikey) ──
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ── Groq (https://console.groq.com) — optional alternative ──
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── OpenRouter (https://openrouter.ai/keys) — optional alternative ──
OPENROUTER_API_KEY=your_openrouter_api_key_here
